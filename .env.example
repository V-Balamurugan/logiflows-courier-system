# ==============================================================================
# LOGIFLOWS COURIER MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
PROJECT_NAME="LogiFlows Courier Management System"
API_V1_STR=/api/v1
SECRET_KEY=logiflows-production-super-secret-key-32-chars-minimum-needed
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection URL
# For production PostgreSQL:
DATABASE_URL=postgresql://logiflows_user:logiflows_pass@localhost:5432/logiflows_db
# For lightweight local development / CI tests (optional fallback):
# DATABASE_URL=sqlite:///./logiflows.db

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Super Admin Seed Initial Credentials
FIRST_SUPERADMIN_EMAIL=superadmin@logiflows.com
FIRST_SUPERADMIN_PASSWORD=SuperAdmin@LogiFlows2026!

# Email Service (SMTP or Brevo API)
SMTP_SERVER=smtp.brevo.com
SMTP_PORT=587
SMTP_USER=no-reply@logiflows.com
SMTP_PASSWORD=brevo_smtp_key_placeholder
EMAIL_FROM=notifications@logiflows.com

# N8N Automation Webhook (optional)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/parcel-events

